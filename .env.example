# Copy to .env and edit. Every value here is optional; these are the defaults.

# The library: books, covers, metadata and reading positions, one SQLite file.
# A path, relative to the repo root unless absolute — it may well point
# outside the repo, e.g. into a synced folder.
DATABASE_URL=library.db

# Bind address. In production this must be the VPN interface, never 0.0.0.0 —
# there is no auth, the tunnel is the perimeter.
#HOST=127.0.0.1
#PORT=8787
