[Unit]
Description=EPUB reader frontend (Vite dev server)
After=epub-reader-backend.service
PartOf=epub-reader.target

[Service]
Type=simple
WorkingDirectory=/home/bagrat/src/epub-reader

# This is the address the reader is actually reached at, since in dev Vite
# serves the page and proxies /api to the backend. Vite binds ::1 by default,
# which is the box itself and nothing else — set this to the VPN interface
# address to read on the phone.
#
# Never `--host` with no value: that is a wildcard bind, and there is no auth
# here. It is spelled as a variable so the flag always has an argument.
Environment=VITE_HOST=::1
ExecStart=/home/bagrat/src/epub-reader/node_modules/.bin/vite --host ${VITE_HOST}
Restart=on-failure

[Install]
WantedBy=default.target
