[Unit]
Description=EPUB reader frontend (Vite dev server)
After=epub-reader-backend.service
PartOf=epub-reader.target

[Service]
Type=simple
WorkingDirectory=/home/bagrat/src/epub-reader

# This is the address the reader is opened at, since in dev Vite serves the
# page and proxies /api to the backend. No --host: Vite binds ::1, and the app
# runs on the device doing the reading, so nothing outside needs to reach it.
# The port (5180) comes from vite.config.ts and is strict — browser storage is
# keyed to that origin, so a book cache survives only while it stays put.
ExecStart=/home/bagrat/src/epub-reader/node_modules/.bin/vite
Restart=on-failure

[Install]
WantedBy=default.target
